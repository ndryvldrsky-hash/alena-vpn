[Unit]
Description=Архив субпотока камеры %i на VPS (последний час)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
User=camarchive
EnvironmentFile=/etc/cam-archive/rtsp.env
ExecStart=/usr/local/sbin/cam-archive-record %i
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
