[Unit]
Description=Удалить куски архива камер старше 6 часов (2026-09-18: было час → 3 ч → 6 ч после субпотоков imac и xps и потолка axis)

[Service]
Type=oneshot
User=camarchive
# кусок пишется минуту: последний модифицирован не раньше его конца, +61 мин = всё, что целиком старше часа
ExecStart=/usr/bin/find /var/lib/cam-archive -type f -name "*.mkv" -mmin +361 -delete
