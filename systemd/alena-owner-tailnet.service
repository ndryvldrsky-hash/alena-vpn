[Unit]
Description=Приватная Алёна по тайнету — запасной чат (127.0.0.1:8099, наружу — tailscale serve :8443)
After=network-online.target

[Service]
User=alenachat
EnvironmentFile=/etc/alena-chat/env
StateDirectory=alena-owner
ExecStart=/usr/local/lib/alena-chat/venv/bin/python3 /usr/local/lib/alena-owner/app.py
Restart=always
RestartSec=5
Nice=5
MemoryMax=200M

[Install]
WantedBy=multi-user.target
