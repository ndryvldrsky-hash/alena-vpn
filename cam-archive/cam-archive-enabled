#!/usr/bin/env python3
# Включена ли камера во Frigate (для архива камер). 2026-10-28.
# Хозяин: «Служба архива должна сама понимать, что если камера выключена, её не надо записывать».
# Признак — Frigate API GET /api/config (порт 5000, без входа, доступен по тайлнету): камера выключена, если
# cameras.<имя>.enabled == false ИЛИ cameras.<имя>.record.enabled == false. Поток go2rtc признаком быть не может:
# продюсеры в go2rtc ленивые, у выключенной камеры поток в списке остаётся.
# Выход: 0 — включена (писать), 1 — выключена (ждать). Нет ответа Frigate / камеры нет в конфиге — 0 (пишем как раньше,
# сбой Frigate не должен останавливать архив).
#   cam-archive-enabled <камера>
import json, os, sys, urllib.request
cam = sys.argv[1]
# адрес Frigate: FRIGATE_API из rtsp.env, иначе хост go2rtc с портом 5000
api = os.environ.get("FRIGATE_API") or "http://" + os.environ.get("RTSP_HOST", "100.66.16.46:8554").split(":")[0] + ":5000"
try:
    with urllib.request.urlopen(api + "/api/config", timeout=8) as r:
        c = json.load(r)["cameras"][cam]
except Exception:
    sys.exit(0)
if c.get("enabled") is False or (c.get("record") or {}).get("enabled") is False:
    sys.exit(1)
sys.exit(0)
